# ---------------------------------------------------------------------------
# Copy to .env.local for development. Nothing here is required to boot the app.
# ---------------------------------------------------------------------------

# Public origin of this deployment. Drives metadataBase, canonical URLs,
# Open Graph image URLs, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://download24.in

# When set, this origin is used for every canonical/sitemap entry while
# NEXT_PUBLIC_SITE_URL keeps pointing at the real host. Use it to stop preview
# deploys from competing with production in Google.
# NEXT_PUBLIC_CANONICAL_URL=https://download24.in

# ---------------------------------------------------------------------------
# Analytics (PostHog) — everything shows up in one PostHog project: pageviews,
# clicks, session replays, heatmaps, web vitals, errors, plus the funnel
# events link_submitted → extraction_completed → quality_selected →
# download_started → download_completed (client AND server side).
# Leave the token unset and nothing is loaded or sent.
# ---------------------------------------------------------------------------

# Project API key from PostHog → Project settings (starts with phc_).
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ingestion host of your PostHog region. Default: US Cloud.
#   US Cloud:     https://us.i.posthog.com
#   EU Cloud:     https://eu.i.posthog.com
#   Self-hosted:  https://posthog.example.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional release label attached to every event (e.g. the git SHA from CI).
# NEXT_PUBLIC_APP_VERSION=2026.09.17

# ---------------------------------------------------------------------------
# Admin dashboard (/admin) — a secure, token-gated UI that reads THIS SAME
# PostHog project over its HTTP API (HogQL): KPIs, the download funnel, raw
# events with full properties, and a read-only SQL runner. Everything runs
# server-side; the API key never reaches the browser.
#
# Leave ADMIN_SECRET unset and the whole /admin area stays inert (no login
# endpoint, no brute-force surface).
# ---------------------------------------------------------------------------

# Shared admin token entered on /admin/login (min. 12 characters — use a long
# random string, e.g. `openssl rand -hex 32`). It signs a 12-hour session
# cookie (HttpOnly, SameSite=Lax, Secure in production); rotating it kills
# every live session.
# ADMIN_SECRET=

# PostHog *personal* API key (PostHog → Settings → Your account → API keys)
# with the "Query Read" permission. Project tokens (phc_…) only ingest events
# and cannot run queries, so this is a separate, server-only credential.
# POSTHOG_PERSONAL_API_KEY=

# Optional: the numeric project ID (project settings page). When unset the
# dashboard resolves it automatically by matching
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN against the projects the key can see.
# POSTHOG_PROJECT_ID=

# ---------------------------------------------------------------------------
# Extraction engine
# ---------------------------------------------------------------------------

# Absolute path to the yt-dlp binary. Leave unset to use the standalone binary
# that youtube-dl-exec downloads into node_modules during `npm install`.
# YTDL_PATH=/usr/local/bin/yt-dlp

# Skip the bundled-binary download if you manage yt-dlp yourself (e.g. via the
# base image). youtube-dl-exec reads both of these at install time.
# YOUTUBE_DL_SKIP_DOWNLOAD=1
# YOUTUBE_DL_SKIP_PYTHON_CHECK=1

# Netscape cookies.txt for age-, login- or region-gated sources.
# YTDL_COOKIES=/run/secrets/ytdlp-cookies.txt

# Override the user-agent used for extraction (helps with some hosts).
# YTDL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# LAME VBR quality for MP3 output: 0 = ~245 kbps (transparent), 9 = smallest.
# MP3_AUDIO_QUALITY=0

# stream   = server pipes the finished file to the browser (default, safest)
# redirect = 302 to the upstream CDN URL for already-muxed sources (less egress)
DOWNLOAD_MODE=redirect

# Timeouts (ms). Keep YTDL_DOWNLOAD_TIMEOUT_MS <= your platform's maxDuration.
# YTDL_EXTRACT_TIMEOUT_MS=60000
# YTDL_DOWNLOAD_TIMEOUT_MS=1800000
# YTDL_STARTUP_TIMEOUT_MS=45000
# YTDL_SOCKET_TIMEOUT=20

# ---------------------------------------------------------------------------
# TeraBox engine (lib/terabox.ts) — the share flow is scraped directly, because
# yt-dlp ships no TeraBox extractor.
# ---------------------------------------------------------------------------

# Cookie used when TeraBox asks the server for a verification step (errno
# 400210 / 460020 / -6). Accepts a bare `ndus` token, a full Cookie header
# ("lang=en; ndus=...") or JSON. Grab it from a logged-in browser session:
# DevTools → Application → Cookies.
#
# It is also what makes TeraBox sign `dlink`s for adult-flagged shares: without
# it those shares still list, but the download button gets "withheld the
# download link". Shares that resolve fine anonymously need no cookie.
# TERABOX_COOKIE=ndus=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional resolver proxy implementing the `?mode=resolve&surl=…&raw=1` contract
# (used first when TeraBox blocks this host's region entirely).
# TERABOX_RESOLVE_PROXY=https://example.workers.dev/

# Force the API origin (defaults to the share host, then the canonical mirrors).
# TERABOX_API_BASE=https://www.terabox.com

# Listing limits: how many files a share may expand into and how deep folders go.
# TERABOX_MAX_FILES=60
# TERABOX_MAX_DEPTH=2

# Per-request timeout for the share page / file list calls.
# TERABOX_TIMEOUT_MS=20000

# Override the browser user-agent the share page is fetched with.
# TERABOX_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Extra hosts accepted by /api/parse, comma separated (no www.).
# EXTRA_ALLOWED_HOSTS=example.com,lectures.university.edu

# Rate limits (per hashed client key, per minute).
RATE_LIMIT_EXTRACT_PER_MIN=60
RATE_LIMIT_DOWNLOAD_PER_MIN=20
# RATE_LIMIT_DOWNLOAD_CONCURRENCY=2

# Show cache/quality headers and X-Cache debug info, plus console debug lines.
# NEXT_PUBLIC_DEBUG_CACHE=1
