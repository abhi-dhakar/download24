{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": ".selftest-build",
    "rootDir": "lib",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/**/*.ts"
  ]
}
